{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "es2024",
    "sourceMap": true,
    "outDir": "dist",
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
