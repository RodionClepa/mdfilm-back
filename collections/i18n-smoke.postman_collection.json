{
  "info": {
    "name": "I18n Smoke Tests",
    "_postman_id": "00000000-0000-0000-0000-0000000000i18",
    "description": "Smoke-test localization via ?lang= (en/ro/ru) and fallback to en. Set collection variables (baseUrl, mediaId, movieId, seriesId, directorId, personId) to match your DB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminUsername", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "token", "value": "" },
    { "key": "lang", "value": "en" },
    { "key": "mediaId", "value": "1" },
    { "key": "movieId", "value": "1" },
    { "key": "seriesId", "value": "1" },
    { "key": "directorId", "value": "1" },
    { "key": "personId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin login (stores token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "admin", "login"]
            }
          }
        },
        {
          "name": "Me (requires token)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
