// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Lookup Tables (Replacing Enums) ---

model MediaType {
  id    Int     @id @default(autoincrement())
  name  String  @unique // e.g., "SERIES", "MOVIE"
  media Media[]

  @@map("Media_Types")
}

model WatchLinkType {
  id         Int         @id @default(autoincrement())
  name       String      @unique // e.g., "TRAILER", "FULL", "CLIP"
  watchLinks WatchLink[]

  @@map("Watch_Link_Types")
}

enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

enum Role {
  USER
  ADMIN
}

// --- Main Models ---

model Media {
  id          Int       @id @default(autoincrement()) @map("media_id")
  title       String
  releaseDate DateTime  @map("release_date")
  synopsis    String?   @db.Text
  country     String?
  posterImage String?   @map("poster_image")
  
  // Relation to MediaType Table
  typeId      Int       @map("type_id")
  type        MediaType @relation(fields: [typeId], references: [id])
 
  // Directors/Cast are attached AFTER media creation
  directors   MediaDirector[]
  cast        MediaCast[]
  
  movieInfo   MovieInfo?
  seriesInfo  SeriesInfo?
  seasons     Season[]
  watchLinks  WatchLink[]

  homepageFeatured HomepageFeaturedMedia[]

  bookmarks Bookmark[]

  @@map("Media")
}

model Director {
  id           Int     @id @default(autoincrement())
  name         String
  earnings     Int?
  biography    String?  @db.Text
  birthDate    DateTime?
  gender       Gender   @default(UNSPECIFIED)
  imageUrl     String?
  placeOfBirth String?
  media        MediaDirector[]
}

model MediaDirector {
  mediaId    Int      @map("media_id")
  directorId Int      @map("director_id")
  createdAt  DateTime @default(now()) @map("created_at")

  media      Media    @relation(fields: [mediaId], references: [id])
  director   Director @relation(fields: [directorId], references: [id])

  @@id([mediaId, directorId])
  @@map("Media_Directors")
}

model Person {
  id           Int        @id @default(autoincrement())
  name         String
  earnings     Int?
  biography    String?    @db.Text
  birthDate    DateTime?
  gender       Gender     @default(UNSPECIFIED)
  imageUrl     String?
  placeOfBirth String?
  cast         MediaCast[]

  @@map("People")
}

model MediaCast {
  mediaId       Int      @map("media_id")
  personId      Int      @map("person_id")
  characterName String?  @map("character_name")
  billingOrder  Int?     @map("billing_order")
  createdAt     DateTime @default(now()) @map("created_at")

  media         Media    @relation(fields: [mediaId], references: [id])
  person        Person   @relation(fields: [personId], references: [id])

  @@id([mediaId, personId])
  @@map("Media_Cast")
}

model MovieInfo {
  mediaId  Int    @id @unique @map("media_id")
  duration Int 
  budget   Float?
  
  media    Media  @relation(fields: [mediaId], references: [id])

  @@map("Movie_Info")
}

model SeriesInfo {
  mediaId      Int       @id @unique @map("media_id")
  totalSeasons Int       @default(1) @map("total_seasons")
  status       String?
  firstAirDate DateTime  @map("first_air_date")
  lastAirDate  DateTime? @map("last_air_date")
  
  media        Media     @relation(fields: [mediaId], references: [id])

  @@map("Series_Info")
}

model Season {
  id           Int       @id @default(autoincrement()) @map("season_id")
  mediaId      Int       @map("media_id")
  seasonNumber Int       @map("season_number")
  releaseYear  Int       @map("release_year")
  
  media        Media     @relation(fields: [mediaId], references: [id])
  episodes     Episode[]

  @@map("Season")
}

model Episode {
  id              Int         @id @default(autoincrement()) @map("episode_id")
  seasonId        Int         @map("season_id")
  episodeNumber   Int         @map("episode_number")
  durationMinutes Int?        @map("duration_minutes")
  airDate         DateTime?   @map("air_date")
  
  season          Season      @relation(fields: [seasonId], references: [id])
  watchLinks      WatchLink[]

  @@map("Episodes")
}

model WatchLink {
  id        Int           @id @default(autoincrement()) @map("watch_id")
  mediaId   Int           @map("media_id")
  episodeId Int?          @map("episode_id")
  platform  String
  url       String

  // Relation to WatchLinkType Table
  typeId    Int           @map("type_id")
  type      WatchLinkType @relation(fields: [typeId], references: [id])

  media     Media         @relation(fields: [mediaId], references: [id])
  episode   Episode?      @relation(fields: [episodeId], references: [id])

  @@map("Watch_Links")
}

model HomepageFeaturedMedia {
  id        Int      @id @default(autoincrement())
  mediaId   Int      @map("media_id")
  position  Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media     Media    @relation(fields: [mediaId], references: [id])

  @@unique([mediaId])
  @@index([enabled, position])
  @@map("Homepage_Featured_Media")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  avatarUrl String?
  googleSub String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks Bookmark[]
  @@map("Users")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  mediaId   Int      @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, createdAt])
  @@index([mediaId])
  @@map("Bookmarks")
}